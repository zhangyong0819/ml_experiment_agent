# Paths are relative to the project root. Fake demos need no credentials.
ML_AGENT_DB=data/experiments.sqlite
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Environment variables are read from the process; .env is not automatically loaded.
LSF_SSH_HOST=
LSF_SSH_PORT=22
LSF_SSH_USERNAME=
LSF_SSH_HOST_ALIAS=
LSF_REMOTE_PROJECT_ROOT=
ENABLE_REAL_LSF=false
LSF_SSH_INTERACTIVE=false
LSF_MEMORY_UNIT=
LSF_QUEUE=

# Single-instance API defaults (no real model or cluster calls).
ML_AGENT_BACKEND=mock
ML_AGENT_MODEL_MODE=fake
